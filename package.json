{
  "name": "wiki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @wiki/backend dev",
    "dev:worker": "pnpm --filter @wiki/worker dev",
    "dev:frontend": "pnpm --filter @wiki/frontend dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:infra": "docker compose -f docker-compose.dev.yml up postgres redis",
    "docker:infra:down": "docker compose -f docker-compose.dev.yml stop postgres redis",
    "db:generate": "pnpm --filter @wiki/backend db:generate",
    "db:migrate": "pnpm --filter @wiki/backend db:migrate",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@types/node": "22.15.17",
    "eslint": "9.26.0",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "3.1.3",
    "zod": "3.25.76"
  }
}
